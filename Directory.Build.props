<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>CS8600;CS8602;CS8603;CS8618;CS8625</WarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NeutralLanguage>en</NeutralLanguage>
    <Product>StormATC</Product>
    <Company>StormATC Contributors</Company>
    <Copyright>Copyright (c) StormATC Contributors</Copyright>
    <Version>0.18.0</Version>
    <AssemblyVersion>0.18.0.0</AssemblyVersion>
    <FileVersion>0.18.0.0</FileVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comment. Documentation is required on domain/application public
         APIs but enforcing it repository-wide adds noise to views and test projects. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <RestoreLockedMode>true</RestoreLockedMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Optional MSFS SimConnect SDK discovery is shared so the executable and test host can
    package the same runtime files as the Infrastructure project that compiles against them.
    Neither SDK binary is checked into source control.
  -->
  <PropertyGroup>
    <MsfsSimConnectPath Condition="'$(MsfsSimConnectPath)' == ''">$(MSFS_SIMCONNECT_PATH)</MsfsSimConnectPath>
    <MsfsSimConnectPath Condition="'$(MsfsSimConnectPath)' == '' AND '$(MSFS_SDK)' != '' AND Exists('$(MSFS_SDK)\SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll')">$(MSFS_SDK)\SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll</MsfsSimConnectPath>
    <!-- The MSFS SDK's installer uses this location by default. Discovering it keeps a normal
         dotnet build from silently replacing the real connector with the no-SDK fallback. -->
    <MsfsSimConnectPath Condition="'$(MsfsSimConnectPath)' == '' AND Exists('C:\MSFS SDK\SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll')">C:\MSFS SDK\SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll</MsfsSimConnectPath>
    <MsfsSimConnectPath Condition="'$(MsfsSimConnectPath)' == '' AND Exists('$(MSBuildThisFileDirectory)lib\msfs\Microsoft.FlightSimulator.SimConnect.dll')">$(MSBuildThisFileDirectory)lib\msfs\Microsoft.FlightSimulator.SimConnect.dll</MsfsSimConnectPath>

    <MsfsSimConnectNativePath Condition="'$(MsfsSimConnectNativePath)' == ''">$(MSFS_SIMCONNECT_NATIVE_PATH)</MsfsSimConnectNativePath>
    <MsfsSimConnectManagedDirectory Condition="'$(MsfsSimConnectPath)' != ''">$([System.IO.Path]::GetDirectoryName('$(MsfsSimConnectPath)'))</MsfsSimConnectManagedDirectory>
    <MsfsSimConnectNativePath Condition="'$(MsfsSimConnectNativePath)' == '' AND '$(MsfsSimConnectManagedDirectory)' != '' AND Exists('$(MsfsSimConnectManagedDirectory)\SimConnect.dll')">$(MsfsSimConnectManagedDirectory)\SimConnect.dll</MsfsSimConnectNativePath>
    <MsfsSimConnectNativePath Condition="'$(MsfsSimConnectNativePath)' == '' AND '$(MsfsSimConnectManagedDirectory)' != '' AND Exists('$(MsfsSimConnectManagedDirectory)\..\SimConnect.dll')">$([System.IO.Path]::GetFullPath('$(MsfsSimConnectManagedDirectory)\..\SimConnect.dll'))</MsfsSimConnectNativePath>
  </PropertyGroup>

  <!-- Keep the SDK/no-SDK state in every project's compiler inputs. Besides making the
       conditional state unambiguous, this invalidates incremental dependency-file generation
       when a developer switches between the two build modes without cleaning. -->
  <PropertyGroup Condition="'$(MsfsSimConnectPath)' != '' AND Exists('$(MsfsSimConnectPath)')">
    <DefineConstants>$(DefineConstants);MSFS_SDK_AVAILABLE</DefineConstants>
  </PropertyGroup>

</Project>

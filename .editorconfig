root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,csproj,props,targets,xaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4

# Namespaces
csharp_style_namespace_declarations = file_scoped:warning

# var usage — be explicit unless the type is obvious from the right-hand side.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression preferences
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion

# Modifiers
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:warning
dotnet_style_readonly_field = true:warning

# this. qualification
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Naming: private fields use _camelCase
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# Analyzer tuning for a desktop prototype
dotnet_diagnostic.CA1848.severity = none   # LoggerMessage delegates — noise at this scale

# CA1873 (log argument evaluation cost) is downgraded rather than silenced. The per-transmission
# hot path in PilotTransmissionCoordinator DOES use compiled LoggerMessage delegates, because it
# runs on every pilot transmission. Everywhere else logging is cold-path — startup, provider
# failures, developer controls — where the boxing cost is irrelevant and inline structured
# logging is far more readable. Keeping this visible as a suggestion means a genuinely hot new
# log site still gets flagged in the IDE.
dotnet_diagnostic.CA1873.severity = suggestion
dotnet_diagnostic.CA1031.severity = none   # handled explicitly at boundaries with logging
dotnet_diagnostic.CA1707.severity = none   # test method names use underscores
dotnet_diagnostic.CA2007.severity = none   # ConfigureAwait: WPF app, default context wanted
dotnet_diagnostic.CA1303.severity = none   # literal strings are not localised yet

[tests/**/*.cs]
dotnet_diagnostic.CA1861.severity = none

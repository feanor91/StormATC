<UserControl x:Class="StormATC.Desktop.Views.VacProfileImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:StormATC.Desktop.Converters"
             xmlns:vm="clr-namespace:StormATC.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:VacProfileImportViewModel}"
             mc:Ignorable="d">

  <UserControl.Resources>
    <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Text="VFR profiles from charts"
               Style="{StaticResource SectionHeaderStyle}" />
    <TextBlock Text="StormATC can read one of your charts (a PDF in the charts folder) with your own language model and propose the aerodrome's VFR profile: reporting points, circuit height and side, preferred runway. The pages of the chart are sent to the provider you chose above, which must be able to read images. The model only proposes: every fact comes with the words of the chart it was read from, you keep or drop each one, and nothing is saved until you confirm."
               Style="{StaticResource SecondaryTextStyle}"
               TextWrapping="Wrap"
               Margin="0,0,0,8" />

    <TextBlock Text="CHART" Style="{StaticResource LabelTextStyle}" />
    <ComboBox ItemsSource="{Binding Charts}"
              SelectedItem="{Binding SelectedChart}"
              DisplayMemberPath="Name"
              Margin="0,0,0,8" />

    <WrapPanel>
      <Button Content="Read the chart"
              Command="{Binding AnalyzeCommand}"
              Style="{StaticResource PrimaryButtonStyle}"
              Margin="0,0,8,0" />
      <Button Content="Refresh the list"
              Command="{Binding RefreshCommand}" />
    </WrapPanel>

    <TextBlock Text="{Binding Status}"
               Style="{StaticResource SecondaryTextStyle}"
               TextWrapping="Wrap"
               Margin="0,8,0,0"
               Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}" />

    <StackPanel Margin="0,12,0,0"
                Visibility="{Binding HasDraft, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{Binding DraftTitle}"
                 Style="{StaticResource ValueTextStyle}"
                 TextWrapping="Wrap" />
      <TextBlock Text="{Binding ExistingNote}"
                 Style="{StaticResource SecondaryTextStyle}"
                 TextWrapping="Wrap"
                 Margin="0,4,0,0"
                 Visibility="{Binding ExistingNote, Converter={StaticResource StringToVisibility}}" />
      <TextBlock Text="{Binding Warnings}"
                 Style="{StaticResource SecondaryTextStyle}"
                 TextWrapping="Wrap"
                 Margin="0,4,0,0"
                 Visibility="{Binding Warnings, Converter={StaticResource StringToVisibility}}" />

      <ItemsControl ItemsSource="{Binding Facts}" Margin="0,8,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6" Padding="10,8">
              <StackPanel>
                <CheckBox IsChecked="{Binding Include}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Value}" />
                  </StackPanel>
                </CheckBox>
                <TextBlock Text="{Binding Evidence}"
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap"
                           Margin="22,2,0,0" />
                <TextBlock Text="The model was not sure of this one: check it against the chart before keeping it."
                           Style="{StaticResource SecondaryTextStyle}"
                           Foreground="{StaticResource StatusWarnBrush}"
                           TextWrapping="Wrap"
                           Margin="22,2,0,0"
                           Visibility="{Binding NeedsReview, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <WrapPanel Margin="0,4,0,0">
        <Button Content="Save the profile"
                Command="{Binding SaveCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                Margin="0,0,8,0" />
        <Button Content="Discard"
                Command="{Binding DiscardCommand}" />
      </WrapPanel>
    </StackPanel>
  </StackPanel>
</UserControl>

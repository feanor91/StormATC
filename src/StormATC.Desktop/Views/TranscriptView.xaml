<UserControl x:Class="StormATC.Desktop.Views.TranscriptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:StormATC.Desktop.Converters"
             xmlns:vm="clr-namespace:StormATC.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:TranscriptViewModel}"
             mc:Ignorable="d">

  <UserControl.Resources>
    <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    <conv:SpeakerToBrushConverter x:Key="SpeakerToBrush" />
  </UserControl.Resources>

  <Grid Margin="28,24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="300" />
    </Grid.ColumnDefinitions>

    <DockPanel Grid.Column="0" LastChildFill="True">

      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
        <Button Content="Live session"
                Style="{StaticResource BaseButtonStyle}"
                Command="{Binding ShowCurrentSessionCommand}" />
        <Button Content="Copy transcript"
                Style="{StaticResource BaseButtonStyle}"
                Command="{Binding CopyTranscriptCommand}"
                Margin="8,0,0,0" />
        <TextBlock Text="{Binding StatusMessage}"
                   Style="{StaticResource SecondaryTextStyle}"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0"
                   TextWrapping="Wrap"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
      </StackPanel>

      <Border Style="{StaticResource CardStyle}" Margin="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Turns}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource SurfaceElevatedBrush}"
                        BorderThickness="3,0,0,0"
                        BorderBrush="{Binding IsPilot, Converter={StaticResource SpeakerToBrush}}"
                        CornerRadius="0,4,4,0"
                        Padding="12,10"
                        Margin="0,0,0,8">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding SpeakerLabel}"
                                 Style="{StaticResource LabelTextStyle}"
                                 Foreground="{Binding IsPilot, Converter={StaticResource SpeakerToBrush}}" />
                      <TextBlock Text="{Binding Time}"
                                 Style="{StaticResource LabelTextStyle}"
                                 Margin="10,0,0,0" />
                      <Border Background="{StaticResource SurfaceCardBrush}"
                              CornerRadius="3"
                              Padding="6,1"
                              Margin="10,0,0,0"
                              Visibility="{Binding HasIntent, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Intent}" Style="{StaticResource LabelTextStyle}" />
                      </Border>
                      <Border Background="{StaticResource SurfaceCardBrush}"
                              CornerRadius="3"
                              Padding="6,1"
                              Margin="6,0,0,0"
                              ToolTip="This response came from deterministic phraseology, not the language model."
                              Visibility="{Binding UsedDeterministicFallback,
                                                   Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="DETERMINISTIC"
                                   Style="{StaticResource LabelTextStyle}"
                                   Foreground="{StaticResource StatusWarnBrush}" />
                      </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding Text}"
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />

                    <TextBlock Style="{StaticResource SecondaryTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Visibility="{Binding HasNormalizedText, Converter={StaticResource BoolToVisibility}}">
                      <Run Text="normalised:" />
                      <Run Text="{Binding NormalizedText, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Text="{Binding Warnings}"
                               Style="{StaticResource SecondaryTextStyle}"
                               Foreground="{StaticResource StatusWarnBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </DockPanel>

    <!-- Stored sessions -->
    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Top"
                   Text="Stored sessions"
                   Style="{StaticResource SectionHeaderStyle}" />

        <TextBlock DockPanel.Dock="Bottom"
                   Text="History is stored on this computer only. Clear it from the Settings page."
                   Style="{StaticResource SecondaryTextStyle}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />

        <ListBox ItemsSource="{Binding PastSessions}"
                 SelectedItem="{Binding SelectedSession}"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,4">
                <TextBlock Text="{Binding StartedAt}" Style="{StaticResource ValueTextStyle}" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap">
                  <Run Text="{Binding Callsign, Mode=OneWay}" />
                  <Run Text="·" />
                  <Run Text="{Binding Route, Mode=OneWay}" />
                </TextBlock>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Mode}" Style="{StaticResource LabelTextStyle}" />
                  <TextBlock Text="{Binding TurnCount, StringFormat={}{0} turns}"
                             Style="{StaticResource LabelTextStyle}"
                             Margin="8,0,0,0" />
                  <Button Content="Open"
                          Style="{StaticResource BaseButtonStyle}"
                          Padding="8,2"
                          Margin="8,0,0,0"
                          Command="{Binding DataContext.LoadSessionCommand,
                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>

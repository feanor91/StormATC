<UserControl x:Class="StormATC.Desktop.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:StormATC.Desktop.Converters"
             xmlns:vm="clr-namespace:StormATC.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:DiagnosticsViewModel}"
             mc:Ignorable="d">

  <UserControl.Resources>
    <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    <conv:ProviderStateToBrushConverter x:Key="ProviderStateToBrush" />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">

        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Providers" Style="{StaticResource SectionHeaderStyle}" />

            <ItemsControl ItemsSource="{Binding ProviderStatus.Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="150" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{Binding State, Converter={StaticResource ProviderStateToBrush}}" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               Style="{StaticResource BodyTextStyle}" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Text="{Binding StateText}"
                               Style="{StaticResource ValueTextStyle}" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="3" Text="{Binding Detail}"
                               Style="{StaticResource SecondaryTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Environment" Style="{StaticResource SectionHeaderStyle}" />

            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="CONFIGURED MODEL" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding ConfiguredModel}" Style="{StaticResource ValueTextStyle}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="SIMULATOR" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding SimulatorState}" Style="{StaticResource ValueTextStyle}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding SimulatorDetail}" Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap"
                           Visibility="{Binding SimulatorDetail, Converter={StaticResource StringToVisibility}}" />
              </StackPanel>
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="FLIGHT PLAN SOURCE" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding FlightPlanSource}" Style="{StaticResource ValueTextStyle}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="DATABASE SCHEMA" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding SchemaVersion}" Style="{StaticResource ValueTextStyle}" />
              </StackPanel>
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="OPENROUTER KEY" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding OpenRouterKeyPresence}" Style="{StaticResource ValueTextStyle}" />
              </StackPanel>
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="DEEPGRAM KEY" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding DeepgramKeyPresence}" Style="{StaticResource ValueTextStyle}" />
              </StackPanel>
            </UniformGrid>

            <TextBlock Text="DATABASE" Style="{StaticResource LabelTextStyle}" />
            <TextBlock Text="{Binding DatabasePath}" Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap" Margin="0,0,0,8" />

            <TextBlock Text="PROMPTS" Style="{StaticResource LabelTextStyle}" />
            <TextBlock Text="{Binding PromptDirectory}" Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Startup warnings" Style="{StaticResource SectionHeaderStyle}" />

            <ItemsControl ItemsSource="{Binding StartupWarnings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}"
                             Style="{StaticResource SecondaryTextStyle}"
                             Foreground="{StaticResource StatusWarnBrush}"
                             TextWrapping="Wrap"
                             Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="2">

        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Latency" Style="{StaticResource SectionHeaderStyle}" />

            <TextBlock Text="{Binding LastLatencySummary}" Style="{StaticResource BodyTextStyle}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding AverageLatencySummary}" Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,4,0,12" />

            <DataGrid ItemsSource="{Binding LatencySamples}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      RowBackground="Transparent"
                      AlternatingRowBackground="{StaticResource SurfaceElevatedBrush}"
                      BorderThickness="0"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      MaxHeight="260">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="*" />
                <DataGridTextColumn Header="Total" Binding="{Binding TotalMs}" Width="Auto" />
                <DataGridTextColumn Header="Parse" Binding="{Binding ParsingMs}" Width="Auto" />
                <DataGridTextColumn Header="Engine" Binding="{Binding EngineMs}" Width="Auto" />
                <DataGridTextColumn Header="Render" Binding="{Binding RenderMs}" Width="Auto" />
                <DataGridTextColumn Header="Persist" Binding="{Binding PersistenceMs}" Width="Auto" />
                <DataGridCheckBoxColumn Header="Fallback" Binding="{Binding UsedDeterministicFallback}" Width="Auto" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Prompts" Style="{StaticResource SectionHeaderStyle}" />

            <ItemsControl ItemsSource="{Binding PromptHashes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource BodyTextStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding Hash}" Style="{StaticResource ValueTextStyle}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Reload prompts from disk"
                    Style="{StaticResource BaseButtonStyle}"
                    Command="{Binding ReloadPromptsCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,12,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Export" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="Writes a text report you can attach to a bug report. It records whether an API key exists but never its value, and contains no audio and no raw provider responses."
                       Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal">
              <Button Content="Export diagnostics"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Command="{Binding ExportDiagnosticsCommand}" />
              <Button Content="Open data folder"
                      Style="{StaticResource BaseButtonStyle}"
                      Command="{Binding OpenDataFolderCommand}"
                      Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="Everything StormATC writes — the database, your settings, the rolling logs, cached flight plans — is in that one folder. Deleting it removes every trace."
                       Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>

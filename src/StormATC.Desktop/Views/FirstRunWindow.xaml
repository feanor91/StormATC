<Window x:Class="StormATC.Desktop.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to StormATC"
        Height="700"
        Width="740"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBackgroundBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}">

  <DockPanel LastChildFill="True" Margin="28,24">

    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="StormATC"
                 FontSize="26"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource AccentBrush}" />
      <TextBlock Text="A free, open-source ATC companion for flight simulation."
                 Style="{StaticResource SecondaryTextStyle}"
                 Margin="0,4,0,20" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
      <Border Style="{StaticResource DividerStyle}" Margin="0,0,0,16" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Continue without cloud services"
                Style="{StaticResource BaseButtonStyle}"
                Click="OnDecline" />
        <Button Content="I understand — continue"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="OnAccept"
                IsEnabled="{Binding ElementName=ScopeAcknowledged, Path=IsChecked}"
                Margin="10,0,0,0" />
      </StackPanel>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <Border Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource StatusWarnBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,14"
                Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="SCOPE"
                       Style="{StaticResource LabelTextStyle}"
                       Foreground="{StaticResource StatusWarnBrush}" />
            <TextBlock Text="StormATC is an entertainment product for flight simulation only. It must not be used for real-world aviation, navigation, flight planning, or air traffic control."
                       Style="{StaticResource BodyTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Cost" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="StormATC itself is free and open source. It has no accounts and no subscription."
                       Style="{StaticResource BodyTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <TextBlock Text="Speech recognition, the controller voice, and model-assisted phrasing are optional and use external services — Deepgram plus your selected OpenRouter, OpenAI, Groq, DeepSeek, or Anthropic API — under your own keys. Those services are independent of StormATC and bill their own API accounts. A ChatGPT subscription does not include OpenAI API usage."
                       Style="{StaticResource BodyTextStyle}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="What leaves your computer" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap">
              <Run Text="• With no keys configured, nothing does. StormATC runs entirely offline with deterministic phraseology and typed transmissions." />
              <LineBreak />
              <Run Text="• With Deepgram enabled, audio captured while you hold push-to-talk is streamed to Deepgram for transcription, and controller text is sent there to be spoken." />
              <LineBreak />
              <Run Text="• With a model provider enabled, transcripts and approved controller facts are sent only to the provider you select so it can interpret or phrase the reply." />
              <LineBreak />
              <Run Text="• Transcripts and session history are stored on this computer only. You can clear them at any time from Settings." />
              <LineBreak />
              <Run Text="• Raw microphone audio is never written to disk unless you explicitly turn that on." />
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Your simulator and your flight plan" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap">
              <Run Text="• StormATC connects to Microsoft Flight Simulator automatically when it is running, and reads only — it never moves your aircraft or changes your radio. Until then it flies a scripted aircraft so you can try everything straight away, and switches over on its own once the simulator appears." />
              <LineBreak />
              <Run Text="• Enter your SimBrief user ID on the Flight Plan page and StormATC imports your latest plan directly. There is nothing to download or open by hand. Without one it flies a bundled fictional sample." />
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="How it decides" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="The simulator determines what is physically true. A deterministic engine determines what is permitted. The language model only helps understand you and phrase what the engine has already approved — it never issues a clearance, and anything it produces that does not match the approved facts is discarded."
                       Style="{StaticResource BodyTextStyle}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <CheckBox x:Name="ScopeAcknowledged"
                  Margin="4,8,0,0"
                  Content="I understand StormATC is for flight simulation only, and that configured cloud APIs are third-party services billed to my own accounts." />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>

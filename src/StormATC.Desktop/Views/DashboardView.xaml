<UserControl x:Class="StormATC.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:StormATC.Desktop.Converters"
             xmlns:vm="clr-namespace:StormATC.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             mc:Ignorable="d">

  <UserControl.Resources>
    <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanConverter x:Key="InverseBoolean" />
    <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    <conv:ProviderStateToBrushConverter x:Key="ProviderStateToBrush" />
    <conv:SpeechStateToBrushConverter x:Key="SpeechStateToBrush" />

    <Style x:Key="MetricLabelStyle" TargetType="TextBlock"
           BasedOn="{StaticResource LabelTextStyle}">
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource ValueFontFamily}" />
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="AudioMeterStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="8" />
      <Setter Property="Background" Value="{StaticResource SurfaceBackgroundBrush}" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="4">
              <Grid x:Name="PART_Track" ClipToBounds="True">
                <Border x:Name="PART_Indicator"
                        HorizontalAlignment="Left"
                        Background="{TemplateBinding Foreground}"
                        CornerRadius="4" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="24,20,24,28">
    <StackPanel>

      <!-- Compact service health: visible, but no longer the visual focus. -->
      <DockPanel Margin="0,0,0,14">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="FLIGHT COMMAND CENTER" Style="{StaticResource LabelTextStyle}" />
          <TextBlock Text="Live simulator context, controller guidance, and radio workflow"
                     Style="{StaticResource SecondaryTextStyle}"
                     Margin="0,3,0,0" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding ProviderStatus.Items}"
                      HorizontalAlignment="Right">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel HorizontalAlignment="Right" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource SurfaceElevatedBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="9,5"
                      Margin="6,0,0,6"
                      ToolTip="{Binding Detail}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                           Fill="{Binding State, Converter={StaticResource ProviderStateToBrush}}" />
                  <TextBlock Text="{Binding Name}"
                             FontSize="11"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             Margin="6,0,0,0" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>

      <!-- The operational context strip answers the four questions that used to require
           opening Diagnostics: is MSFS live, what is the weather, is traffic nearby, and
           did the current scenery produce a usable airport graph? -->
      <Border Background="{StaticResource SurfaceInsetBrush}"
              BorderBrush="{StaticResource BorderStrongBrush}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="6"
              Margin="0,0,0,14">
        <UniformGrid Columns="4">
          <Border Background="{StaticResource SurfaceCardBrush}"
                  CornerRadius="8"
                  Padding="14,11"
                  Margin="0,0,4,0">
            <StackPanel>
              <TextBlock Text="SIMULATOR" Style="{StaticResource LabelTextStyle}" />
              <TextBlock Text="{Binding SimulatorStatus}"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Margin="0,4,0,0" />
              <TextBlock Text="{Binding SimulatorStatusDetail}"
                         Style="{StaticResource SecondaryTextStyle}"
                         FontSize="10"
                         TextTrimming="CharacterEllipsis"
                         Margin="0,3,0,0" />
            </StackPanel>
          </Border>

          <Border Background="{StaticResource SurfaceCardBrush}"
                  CornerRadius="8"
                  Padding="14,11"
                  Margin="4,0">
            <StackPanel>
              <TextBlock Text="LIVE WEATHER" Style="{StaticResource LabelTextStyle}" />
              <TextBlock Text="{Binding WeatherSummary}"
                         FontFamily="{StaticResource ValueFontFamily}"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Margin="0,4,0,0" />
              <TextBlock Text="{Binding WeatherDetail}"
                         Style="{StaticResource SecondaryTextStyle}"
                         FontSize="10"
                         TextTrimming="CharacterEllipsis"
                         Margin="0,3,0,0" />
            </StackPanel>
          </Border>

          <Border Background="{StaticResource SurfaceCardBrush}"
                  CornerRadius="8"
                  Padding="14,11"
                  Margin="4,0">
            <StackPanel>
              <TextBlock Text="NEARBY TRAFFIC" Style="{StaticResource LabelTextStyle}" />
              <TextBlock Text="{Binding TrafficSummary}"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Margin="0,4,0,0" />
              <TextBlock Text="{Binding TrafficDetail}"
                         Style="{StaticResource SecondaryTextStyle}"
                         FontSize="10"
                         TextTrimming="CharacterEllipsis"
                         Margin="0,3,0,0" />
            </StackPanel>
          </Border>

          <Border Background="{StaticResource SurfaceCardBrush}"
                  CornerRadius="8"
                  Padding="14,11"
                  Margin="4,0,0,0">
            <StackPanel>
              <TextBlock Text="AIRPORT SCENERY" Style="{StaticResource LabelTextStyle}" />
              <TextBlock Text="{Binding AirportDataSummary}"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}"
                         Margin="0,4,0,0" />
              <TextBlock Text="{Binding AirportDataDetail}"
                         Style="{StaticResource SecondaryTextStyle}"
                         FontSize="10"
                         TextTrimming="CharacterEllipsis"
                         Margin="0,3,0,0" />
            </StackPanel>
          </Border>
        </UniformGrid>
      </Border>

      <Border Background="{StaticResource StatusErrorSubtleBrush}"
              BorderBrush="{StaticResource StatusErrorBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="16,12"
              Margin="0,0,0,14"
              Visibility="{Binding HasActiveWarning, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="34" Height="34" CornerRadius="17"
                  Background="{StaticResource StatusErrorBrush}"
                  VerticalAlignment="Top">
            <TextBlock Text="!" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource SurfaceBackgroundBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <TextBlock Text="Action required"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource StatusErrorBrush}" />
            <TextBlock Text="{Binding ActiveWarning}"
                       Style="{StaticResource BodyTextStyle}"
                       Margin="0,3,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.72*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Primary operational picture -->
        <StackPanel Grid.Column="0">
          <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                  <TextBlock Text="ACTIVE FLIGHT" Style="{StaticResource LabelTextStyle}" />
                  <TextBlock Text="{Binding Callsign}"
                             FontFamily="{StaticResource ValueFontFamily}"
                             FontSize="34"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"
                             Margin="0,2,0,0" />
                  <TextBlock Text="{Binding RouteSummary}"
                             Style="{StaticResource SecondaryTextStyle}"
                             Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                  <Border Background="{StaticResource AccentSubtleBrush}"
                          BorderBrush="{StaticResource AccentDimBrush}"
                          BorderThickness="1"
                          CornerRadius="10"
                          Padding="10,5">
                    <TextBlock Text="{Binding ModeBadge}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                  </Border>
                  <TextBlock Text="{Binding FlightPhase}"
                             HorizontalAlignment="Right"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Margin="0,8,0,0" />
                </StackPanel>
              </Grid>

              <Border Style="{StaticResource DividerStyle}" Margin="0,16,0,16" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.05*" />
                  <ColumnDefinition Width="1.25*" />
                  <ColumnDefinition Width="0.8*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="CONTROLLER" Style="{StaticResource MetricLabelStyle}" />
                  <TextBlock Text="{Binding CurrentController}"
                             FontSize="22"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Current position"
                             Style="{StaticResource SecondaryTextStyle}"
                             FontSize="11"
                             Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                  <TextBlock Text="WORKING FREQUENCY" Style="{StaticResource MetricLabelStyle}" />
                  <TextBlock Text="{Binding CurrentFrequency}"
                             Style="{StaticResource MetricValueStyle}"
                             Foreground="{StaticResource AccentBrush}" />
                  <TextBlock Text="{Binding FrequencySource}"
                             Style="{StaticResource SecondaryTextStyle}"
                             FontSize="11"
                             Margin="0,4,0,0"
                             TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="RUNWAY" Style="{StaticResource MetricLabelStyle}" />
                  <TextBlock Text="{Binding ActiveRunway}" Style="{StaticResource MetricValueStyle}" />
                  <TextBlock Text="Assigned"
                             Style="{StaticResource SecondaryTextStyle}"
                             FontSize="11"
                             Margin="0,4,0,0" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Guidance is deliberately prominent: it answers “what should I say?” -->
          <Border Background="{StaticResource AccentSubtleBrush}"
                  BorderBrush="{StaticResource AccentDimBrush}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="18"
                  Margin="0,0,0,14">
            <StackPanel>
              <DockPanel>
                <TextBlock Text="WHAT TO SAY NEXT"
                           Style="{StaticResource LabelTextStyle}"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock DockPanel.Dock="Right"
                           Text="TRAINING GUIDANCE"
                           FontSize="10"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           HorizontalAlignment="Right" />
              </DockPanel>
              <TextBlock Text="{Binding NextCallTitle}"
                         FontSize="21"
                         FontWeight="SemiBold"
                         Margin="0,7,0,0" />
              <TextBlock Text="{Binding NextCallDetail}"
                         Style="{StaticResource SecondaryTextStyle}"
                         Margin="0,5,0,0" />

              <Border Background="{StaticResource SurfaceBackgroundBrush}"
                      BorderBrush="{StaticResource BorderStrongBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="13,10"
                      Margin="0,12,0,0"
                      Visibility="{Binding HasNextCallExample, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <DockPanel>
                    <TextBlock Text="EXAMPLE CALL"
                               Style="{StaticResource LabelTextStyle}"
                               VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right"
                            Content="Copy"
                            Command="{Binding CopyNextCallCommand}"
                            Padding="10,4"
                            FontSize="11"
                            HorizontalAlignment="Right" />
                  </DockPanel>
                  <TextBlock Text="{Binding NextCallExample}"
                             Style="{StaticResource BodyTextStyle}"
                             FontSize="14"
                             TextWrapping="Wrap"
                             Margin="0,4,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Live surface guidance supplements concise VATSIM-style radio phraseology. -->
          <Border Style="{StaticResource CardStyle}"
                  Margin="0,0,0,14"
                  Visibility="{Binding HasSurfaceGuidance, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <DockPanel Margin="0,0,0,12">
                <TextBlock Text="Surface route"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding SurfaceProgress}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Right" />
              </DockPanel>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1*" />
                  <ColumnDefinition Width="18" />
                  <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="AIRCRAFT IS HERE"
                             Style="{StaticResource MetricLabelStyle}" />
                  <TextBlock Text="{Binding SurfacePosition}"
                             FontSize="15"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap"
                             Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="CLEARANCE LIMIT"
                             Style="{StaticResource MetricLabelStyle}" />
                  <TextBlock Text="{Binding SurfaceDestination}"
                             FontSize="15"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap"
                             Margin="0,4,0,0" />
                </StackPanel>
              </Grid>

              <Border Background="{StaticResource SurfaceBackgroundBrush}"
                      BorderBrush="{StaticResource BorderStrongBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="13,10"
                      Margin="0,13,0,0">
                <StackPanel>
                  <TextBlock Text="CLEARED TAXIWAYS"
                             Style="{StaticResource MetricLabelStyle}" />
                  <TextBlock Text="{Binding SurfaceRoute}"
                             FontFamily="{StaticResource ValueFontFamily}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap"
                             Margin="0,5,0,0" />
                </StackPanel>
              </Border>

              <Border Background="{StaticResource AccentSubtleBrush}"
                      BorderBrush="{StaticResource AccentDimBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="13,10"
                      Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock Text="NEXT MOVEMENT"
                             Style="{StaticResource MetricLabelStyle}"
                             Foreground="{StaticResource AccentBrush}" />
                  <TextBlock Text="{Binding SurfaceNextAction}"
                             FontSize="16"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap"
                             Margin="0,5,0,0" />
                </StackPanel>
              </Border>

              <Border Background="{StaticResource StatusWarnSubtleBrush}"
                      BorderBrush="{StaticResource StatusWarnBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="13,10"
                      Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock Text="EXPECTED SIGN CUES · INFERRED FROM MSFS TAXI GRAPH"
                             Style="{StaticResource MetricLabelStyle}"
                             Foreground="{StaticResource StatusWarnBrush}" />
                  <TextBlock Text="{Binding SurfaceSignCue}"
                             Style="{StaticResource BodyTextStyle}"
                             TextWrapping="Wrap"
                             Margin="0,5,0,0" />
                  <TextBlock Text="Always cross-check the current airport chart. StormATC cannot read placed sign objects from SimConnect."
                             Style="{StaticResource SecondaryTextStyle}"
                             FontSize="10"
                             TextWrapping="Wrap"
                             Margin="0,6,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Clearance" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock Text="{Binding ActiveClearance}"
                           Style="{StaticResource BodyTextStyle}"
                           MinHeight="38" />
                <Border Style="{StaticResource DividerStyle}" Margin="0,12,0,12" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="SQUAWK" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding Squawk}" Style="{StaticResource MetricValueStyle}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="READBACK DUE" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding PendingReadback}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock Text="Aircraft" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                  <TextBlock DockPanel.Dock="Right"
                             Text="{Binding AircraftIdentity}"
                             Style="{StaticResource SecondaryTextStyle}"
                             FontSize="10"
                             TextTrimming="CharacterEllipsis"
                             MaxWidth="190"
                             HorizontalAlignment="Right" />
                </DockPanel>
                <UniformGrid Columns="3">
                  <StackPanel>
                    <TextBlock Text="ALTITUDE" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding Altitude}" Style="{StaticResource MetricValueStyle}"
                               FontSize="17" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="HEADING" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource MetricValueStyle}"
                               FontSize="17" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="SPEED" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding GroundSpeed}" Style="{StaticResource MetricValueStyle}"
                               FontSize="17" />
                  </StackPanel>
                </UniformGrid>
                <Border Style="{StaticResource DividerStyle}" Margin="0,13,0,11" />
                <UniformGrid Columns="3">
                  <StackPanel>
                    <TextBlock Text="AIRSPEED" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding IndicatedAirspeed}"
                               FontFamily="{StaticResource ValueFontFamily}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="VERTICAL" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding VerticalSpeed}"
                               FontFamily="{StaticResource ValueFontFamily}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="HEIGHT" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding AltitudeAboveGround}"
                               FontFamily="{StaticResource ValueFontFamily}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                  </StackPanel>
                </UniformGrid>
                <TextBlock Text="{Binding AircraftConfiguration}"
                           Style="{StaticResource SecondaryTextStyle}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,11,0,0" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <TextBlock Text="Last exchange" Style="{StaticResource SectionHeaderStyle}"
                           Margin="0" />
                <TextBlock DockPanel.Dock="Right"
                           Text="Full history in Transcript"
                           Style="{StaticResource SecondaryTextStyle}"
                           FontSize="11"
                           HorizontalAlignment="Right" />
              </DockPanel>

              <Border Background="{StaticResource SurfaceElevatedBrush}"
                      BorderThickness="3,0,0,0"
                      BorderBrush="{StaticResource PilotAccentBrush}"
                      CornerRadius="0,7,7,0"
                      Padding="12,9"
                      Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="PILOT" Style="{StaticResource LabelTextStyle}" />
                  <TextBlock Text="{Binding LastPilotTransmission}"
                             Style="{StaticResource BodyTextStyle}"
                             Margin="0,3,0,0" />
                </StackPanel>
              </Border>

              <Border Background="{StaticResource SurfaceElevatedBrush}"
                      BorderThickness="3,0,0,0"
                      BorderBrush="{StaticResource ControllerAccentBrush}"
                      CornerRadius="0,7,7,0"
                      Padding="12,9">
                <StackPanel>
                  <TextBlock Text="CONTROLLER" Style="{StaticResource LabelTextStyle}" />
                  <TextBlock Text="{Binding LastControllerTransmission}"
                             Style="{StaticResource BodyTextStyle}"
                             Margin="0,3,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Radio action column -->
        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Push to talk" Style="{StaticResource SectionHeaderStyle}" />
              <TextBlock Text="{Binding PushToTalkHint}"
                         Style="{StaticResource SecondaryTextStyle}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,14" />

              <Button Style="{StaticResource PushToTalkButtonStyle}"
                      Content="{Binding PushToTalkLabel}"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"
                      PreviewMouseLeftButtonDown="OnPushToTalkPressed"
                      PreviewMouseLeftButtonUp="OnPushToTalkReleased"
                      Margin="0,0,0,14"
                      ToolTip="Hold to transmit; release to send" />

              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                         Fill="{Binding SpeechState, Converter={StaticResource SpeechStateToBrush}}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding SpeechStateText}"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="8,0,0,0" />
              </Grid>

              <ProgressBar Style="{StaticResource AudioMeterStyle}"
                           Minimum="0"
                           Maximum="1"
                           Value="{Binding InputLevel}" />

              <Border Background="{StaticResource SurfaceElevatedBrush}"
                      CornerRadius="7"
                      Padding="10,8"
                      Margin="0,12,0,0"
                      Visibility="{Binding InterimTranscript,
                                           Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding InterimTranscript}"
                           Style="{StaticResource SecondaryTextStyle}"
                           FontStyle="Italic" />
              </Border>

              <Button Content="Replay controller"
                      Style="{StaticResource BaseButtonStyle}"
                      Command="{Binding ReplayLastTransmissionCommand}"
                      HorizontalAlignment="Stretch"
                      Margin="0,14,0,0" />

              <TextBlock Text="{Binding LastVoiceDescription}"
                         Style="{StaticResource SecondaryTextStyle}"
                         Margin="0,8,0,0"
                         Visibility="{Binding LastVoiceDescription,
                                              Converter={StaticResource StringToVisibility}}" />

              <Button Content="Set this voice aside"
                      Style="{StaticResource BaseButtonStyle}"
                      Command="{Binding RejectLastVoiceCommand}"
                      ToolTip="Never use this voice again. The controller gets another one next time."
                      HorizontalAlignment="Stretch"
                      Margin="0,8,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <StackPanel>
              <DockPanel Margin="0,0,0,12"
                         LastChildFill="False">
                <TextBlock Text="Radio" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                <Border DockPanel.Dock="Right"
                        Background="{StaticResource SurfaceElevatedBrush}"
                        CornerRadius="8"
                        Padding="8,3">
                  <TextBlock Text="ACTIVE COM"
                             Style="{StaticResource LabelTextStyle}"
                             FontSize="10" />
                </Border>
              </DockPanel>

              <TextBlock Text="{Binding TunedFrequency}"
                         FontFamily="{StaticResource ValueFontFamily}"
                         FontSize="30"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="{Binding FrequencyStatus}"
                         Style="{StaticResource SecondaryTextStyle}"
                         Margin="0,5,0,0" />

              <Border Background="{StaticResource StatusWarnSubtleBrush}"
                      BorderBrush="{StaticResource StatusWarnBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="11,8"
                      Margin="0,12,0,0"
                      Visibility="{Binding HasFrequencyMismatch, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="The tuned radio does not match the ATC-assigned frequency."
                           Style="{StaticResource BodyTextStyle}" />
              </Border>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}"
                  Margin="0,0,0,14"
                  Visibility="{Binding HasTrafficRadioExchange,
                                       Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <DockPanel Margin="0,0,0,10"
                         LastChildFill="False">
                <TextBlock Text="Traffic radio"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0" />
                <Border DockPanel.Dock="Right"
                        Background="{StaticResource StatusOkSubtleBrush}"
                        CornerRadius="8"
                        Padding="8,3">
                  <TextBlock Text="SIMULATED"
                             Style="{StaticResource LabelTextStyle}"
                             Foreground="{StaticResource StatusOkBrush}" />
                </Border>
              </DockPanel>
              <TextBlock Text="{Binding LatestTrafficRadio}"
                         Style="{StaticResource BodyTextStyle}"
                         TextWrapping="Wrap"
                         LineHeight="20" />
            </StackPanel>
          </Border>

          <Border Background="{StaticResource SurfaceElevatedBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="12,9"
                  Margin="0,0,0,14"
                  Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource SecondaryTextStyle}" />
          </Border>

          <!-- Typed calls keep the complete app usable without a microphone or cloud service. -->
          <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <StackPanel>
              <DockPanel Margin="0,0,0,6"
                         LastChildFill="False">
                <TextBlock Text="Typed transmission"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0" />
                <Border DockPanel.Dock="Right"
                        Background="{StaticResource StatusOkSubtleBrush}"
                        CornerRadius="8"
                        Padding="8,3">
                  <TextBlock Text="LOCAL"
                             Style="{StaticResource LabelTextStyle}"
                             Foreground="{StaticResource StatusOkBrush}" />
                </Border>
              </DockPanel>
              <TextBlock Text="Use the full ATC pipeline without opening the microphone."
                         Style="{StaticResource SecondaryTextStyle}"
                         Margin="0,0,0,10" />
              <TextBox Text="{Binding ManualTransmissionText, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="False"
                       MinHeight="50"
                       VerticalContentAlignment="Top"
                       KeyDown="OnManualTransmissionKeyDown"
                       Margin="0,0,0,8" />
              <Button Content="Send transmission"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Command="{Binding SendManualTransmissionCommand}"
                      HorizontalAlignment="Stretch" />
            </StackPanel>
          </Border>

          <!-- Developer simulator tools remain available only in the scripted mock. -->
          <Border Style="{StaticResource CardStyle}"
                  Visibility="{Binding IsDeveloperMode, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="Mock simulator tools" Style="{StaticResource SectionHeaderStyle}" />
              <TextBlock Text="MOCK AIRCRAFT" Style="{StaticResource LabelTextStyle}" />
              <TextBlock Text="{Binding MockStageText}"
                         FontWeight="SemiBold"
                         FontSize="16"
                         Margin="0,4,0,10" />

              <UniformGrid Columns="2" Margin="0,0,0,8">
                <Button Content="Advance"
                        Command="{Binding AdvanceMockStageCommand}"
                        Margin="0,0,4,0" />
                <Button Content="Reset"
                        Command="{Binding ResetMockSimulatorCommand}"
                        Margin="4,0,0,0" />
              </UniformGrid>
              <UniformGrid Columns="2" Margin="0,0,0,8">
                <Button Content="Incursion"
                        Command="{Binding TriggerRunwayIncursionCommand}"
                        Margin="0,0,4,0" />
                <Button Content="Occupy runway"
                        Command="{Binding TriggerRunwayOccupiedCommand}"
                        Margin="4,0,0,0" />
              </UniformGrid>
              <Button Content="Clear traffic"
                      Command="{Binding ClearMockTrafficCommand}"
                      HorizontalAlignment="Stretch" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl x:Class="StormATC.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:StormATC.Desktop.Converters"
             xmlns:vm="clr-namespace:StormATC.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             mc:Ignorable="d">

  <UserControl.Resources>
    <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:StringToVisibilityConverter x:Key="StringToVisibility" />

    <!-- A model in a picker: its identifier, with a badge for models offered at no cost. -->
    <DataTemplate x:Key="ModelChoiceTemplate">
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right"
                Margin="12,0,0,0"
                Padding="6,1"
                CornerRadius="4"
                BorderThickness="1"
                BorderBrush="{StaticResource StatusOkBrush}"
                Visibility="{Binding IsFree, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="Free"
                     FontSize="10"
                     Foreground="{StaticResource StatusOkBrush}" />
        </Border>
        <TextBlock Text="{Binding Id}" ToolTip="{Binding Name}" />
      </DockPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Background="{StaticResource SurfaceBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- A compact security summary stays visible while moving between settings groups. -->
    <Border Grid.Row="0"
            Background="{StaticResource SurfaceElevatedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="26,16">
      <Grid MaxWidth="1040" HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Configuration centre"
                     FontSize="17"
                     FontWeight="SemiBold" />
          <TextBlock Text="Services, voice controls, ATC behaviour and privacy are separated so changes are easier to understand."
                     Style="{StaticResource SecondaryTextStyle}"
                     Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Column="1"
                Background="{StaticResource StatusOkSubtleBrush}"
                BorderBrush="{StaticResource StatusOkBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,7"
                Margin="20,0,0,0"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72E;"
                       FontFamily="{StaticResource IconFontFamily}"
                       Foreground="{StaticResource StatusOkBrush}"
                       FontSize="15" />
            <TextBlock Text="KEYS PROTECTED BY WINDOWS"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource StatusOkBrush}"
                       Margin="7,0,0,0"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <TabControl Grid.Row="1"
                Style="{StaticResource SettingsTabControlStyle}"
                Margin="26,18,20,10">

      <!-- ==================== Services ==================== -->
      <TabItem Header="Services"
               Style="{StaticResource SettingsTabItemStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,18">
          <StackPanel MaxWidth="1040" HorizontalAlignment="Left">

            <Border Background="{StaticResource StatusWarnSubtleBrush}"
                    BorderBrush="{StaticResource StatusWarnBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12"
                    Margin="0,0,0,14">
              <TextBlock Text="{Binding Disclaimer}"
                         Style="{StaticResource BodyTextStyle}"
                         TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Cloud access" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock Text="{Binding CostNotice}"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,12" />

                <CheckBox Content="I understand configured cloud APIs are third-party services billed to my own accounts"
                          IsChecked="{Binding CloudServicesConsentGiven}"
                          Margin="0,0,0,8" />
                <CheckBox Content="Offline mode — block every network provider"
                          IsChecked="{Binding OfflineMode}"
                          Margin="0,0,0,4" />
                <TextBlock Text="A fresh installation sends nothing until you configure a service. Offline mode is a stronger guarantee and applies after restart."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="24,0,0,0" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel Margin="0,0,0,14"
                           LastChildFill="False">
                  <StackPanel>
                    <TextBlock Text="API keys" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                    <TextBlock Text="Stored with Windows DPAPI. Keys never enter appsettings, logs, history, or diagnostics."
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,4,0,0" />
                  </StackPanel>
                  <Border DockPanel.Dock="Right"
                          Background="{StaticResource AccentSubtleBrush}"
                          CornerRadius="8"
                          Padding="10,5">
                    <TextBlock Text="HIDDEN AFTER SAVE"
                               Style="{StaticResource LabelTextStyle}"
                               Foreground="{StaticResource AccentBrush}" />
                  </Border>
                </DockPanel>

                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="OPENROUTER" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding OpenRouterKeyStatus}"
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,5,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <PasswordBox x:Name="OpenRouterKeyBox"
                                 MaxWidth="500"
                                 HorizontalAlignment="Stretch" />
                    <WrapPanel Margin="0,8,0,0">
                      <Button Content="Save key"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Click="OnSaveOpenRouterKey"
                              Margin="0,0,8,0" />
                      <Button Content="Remove"
                              Command="{Binding RemoveOpenRouterKeyCommand}" />
                    </WrapPanel>
                  </StackPanel>
                </Grid>

                <Border Style="{StaticResource DividerStyle}" Margin="0,0,0,18" />

                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="OPENAI API" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding OpenAIKeyStatus}"
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,5,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <PasswordBox x:Name="OpenAIKeyBox"
                                 MaxWidth="500"
                                 HorizontalAlignment="Stretch" />
                    <WrapPanel Margin="0,8,0,0">
                      <Button Content="Save key"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Click="OnSaveOpenAIKey"
                              Margin="0,0,8,0" />
                      <Button Content="Remove"
                              Command="{Binding RemoveOpenAIKeyCommand}" />
                    </WrapPanel>
                    <TextBlock Text="Use an OpenAI Platform API key. ChatGPT subscriptions are billed separately."
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,7,0,0" />
                  </StackPanel>
                </Grid>

                <Border Style="{StaticResource DividerStyle}" Margin="0,0,0,18" />

                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="GROQ" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding GroqKeyStatus}"
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,5,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <PasswordBox x:Name="GroqKeyBox"
                                 MaxWidth="500"
                                 HorizontalAlignment="Stretch" />
                    <WrapPanel Margin="0,8,0,0">
                      <Button Content="Save key"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Click="OnSaveGroqKey"
                              Margin="0,0,8,0" />
                      <Button Content="Remove"
                              Command="{Binding RemoveGroqKeyCommand}" />
                    </WrapPanel>
                  </StackPanel>
                </Grid>

                <Border Style="{StaticResource DividerStyle}" Margin="0,0,0,18" />

                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="DEEPSEEK" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding DeepSeekKeyStatus}"
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,5,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <PasswordBox x:Name="DeepSeekKeyBox"
                                 MaxWidth="500"
                                 HorizontalAlignment="Stretch" />
                    <WrapPanel Margin="0,8,0,0">
                      <Button Content="Save key"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Click="OnSaveDeepSeekKey"
                              Margin="0,0,8,0" />
                      <Button Content="Remove"
                              Command="{Binding RemoveDeepSeekKeyCommand}" />
                    </WrapPanel>
                  </StackPanel>
                </Grid>

                <Border Style="{StaticResource DividerStyle}" Margin="0,0,0,18" />

                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="ANTHROPIC" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding AnthropicKeyStatus}"
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,5,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <PasswordBox x:Name="AnthropicKeyBox"
                                 MaxWidth="500"
                                 HorizontalAlignment="Stretch" />
                    <WrapPanel Margin="0,8,0,0">
                      <Button Content="Save key"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Click="OnSaveAnthropicKey"
                              Margin="0,0,8,0" />
                      <Button Content="Remove"
                              Command="{Binding RemoveAnthropicKeyCommand}" />
                    </WrapPanel>
                  </StackPanel>
                </Grid>

                <Border Style="{StaticResource DividerStyle}" Margin="0,0,0,18" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="DEEPGRAM" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding DeepgramKeyStatus}"
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,5,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <PasswordBox x:Name="DeepgramKeyBox"
                                 MaxWidth="500"
                                 HorizontalAlignment="Stretch" />
                    <WrapPanel Margin="0,8,0,0">
                      <Button Content="Save key"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Click="OnSaveDeepgramKey"
                              Margin="0,0,8,0" />
                      <Button Content="Test connection"
                              Command="{Binding TestDeepgramCommand}"
                              Margin="0,0,8,0" />
                      <Button Content="Remove"
                              Command="{Binding RemoveDeepgramKeyCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding DeepgramTestResult}"
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,8,0,0"
                               Visibility="{Binding DeepgramTestResult,
                                                    Converter={StaticResource StringToVisibility}}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Provider configuration"
                           Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock Text="Choose one language-model provider. Save settings before testing the connection."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,14" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="1*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel>
                    <TextBlock Text="ACTIVE LANGUAGE MODEL PROVIDER"
                               Style="{StaticResource LabelTextStyle}" />
                    <ComboBox ItemsSource="{Binding LanguageModelProviderNames}"
                              SelectedItem="{Binding SelectedLanguageModelProvider}"
                              Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,14">
                      <Button Content="Test selected provider"
                              Command="{Binding TestLanguageModelCommand}"
                              Style="{StaticResource PrimaryButtonStyle}" />
                      <TextBlock Text="{Binding LanguageModelTestResult}"
                                 Style="{StaticResource SecondaryTextStyle}"
                                 Margin="10,7,0,0"
                                 Visibility="{Binding LanguageModelTestResult,
                                                      Converter={StaticResource StringToVisibility}}" />
                    </WrapPanel>

                    <WrapPanel Margin="0,0,0,12">
                      <Button Content="Refresh model lists"
                              Command="{Binding RefreshModelListsCommand}"
                              Style="{StaticResource BaseButtonStyle}" />
                      <TextBlock Text="{Binding ModelListStatus}"
                                 Style="{StaticResource SecondaryTextStyle}"
                                 Margin="10,7,0,0"
                                 TextWrapping="Wrap"
                                 Visibility="{Binding ModelListStatus,
                                                      Converter={StaticResource StringToVisibility}}" />
                    </WrapPanel>

                    <TextBlock Text="OPENROUTER MODEL" Style="{StaticResource LabelTextStyle}" />
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding OpenRouterModels}"
                              ItemTemplate="{StaticResource ModelChoiceTemplate}"
                              TextSearch.TextPath="Id"
                              Text="{Binding OpenRouterModel, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,0,12" />

                    <TextBlock Text="OPENAI MODEL" Style="{StaticResource LabelTextStyle}" />
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding OpenAIModels}"
                              ItemTemplate="{StaticResource ModelChoiceTemplate}"
                              TextSearch.TextPath="Id"
                              Text="{Binding OpenAIModel, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,0,12" />

                    <TextBlock Text="GROQ MODEL" Style="{StaticResource LabelTextStyle}" />
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding GroqModels}"
                              ItemTemplate="{StaticResource ModelChoiceTemplate}"
                              TextSearch.TextPath="Id"
                              Text="{Binding GroqModel, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,0,12" />

                    <TextBlock Text="DEEPSEEK MODEL" Style="{StaticResource LabelTextStyle}" />
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding DeepSeekModels}"
                              ItemTemplate="{StaticResource ModelChoiceTemplate}"
                              TextSearch.TextPath="Id"
                              Text="{Binding DeepSeekModel, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,0,12" />

                    <TextBlock Text="ANTHROPIC MODEL" Style="{StaticResource LabelTextStyle}" />
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding AnthropicModels}"
                              ItemTemplate="{StaticResource ModelChoiceTemplate}"
                              TextSearch.TextPath="Id"
                              Text="{Binding AnthropicModel, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <TextBlock Text="DEEPGRAM SPEECH MODEL"
                               Style="{StaticResource LabelTextStyle}" />
                    <TextBox Text="{Binding DeepgramSpeechModel, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12" />

                    <TextBlock Text="DEEPGRAM CONTROLLER VOICE"
                               Style="{StaticResource LabelTextStyle}" />
                    <TextBox Text="{Binding DeepgramVoice, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12" />

                    <TextBlock Text="SIMBRIEF USER ID" Style="{StaticResource LabelTextStyle}" />
                    <TextBox Text="{Binding SimBriefUserId, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,4" />
                    <TextBlock Text="Used only when you explicitly import a plan."
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,0,0,12" />

                    <TextBlock Text="SIMULATOR CONNECTOR"
                               Style="{StaticResource LabelTextStyle}" />
                    <ComboBox ItemsSource="{Binding Connectors}"
                              SelectedItem="{Binding PreferredConnector}"
                              Margin="0,0,0,6" />
                    <TextBlock Text="MSFS uses local SimConnect for live data and the initial COM1 ATIS tune. Developer Mode is not required."
                               Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="{Binding SimulatorStatus}"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"
                               Visibility="{Binding SimulatorStatus,
                                                    Converter={StaticResource StringToVisibility}}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ==================== Live integrations ==================== -->
      <TabItem Header="Live integrations"
               Style="{StaticResource SettingsTabItemStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,18">
          <StackPanel MaxWidth="1040" HorizontalAlignment="Left">

            <Border Background="{StaticResource StatusWarnSubtleBrush}"
                    BorderBrush="{StaticResource StatusWarnBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,13"
                    Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7BA;"
                           FontFamily="{StaticResource IconFontFamily}"
                           FontSize="22"
                           Foreground="{StaticResource StatusWarnBrush}"
                           VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="13,0,0,0">
                  <TextBlock Text="Nothing on this page activates itself"
                             FontSize="15"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding TrafficCreditNotice}"
                             Style="{StaticResource SecondaryTextStyle}"
                             Margin="0,5,0,0"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="FSLTL and simulator traffic"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0" />
                    <TextBlock Text="Observe aircraft injected through SimConnect by FSLTL, vPilot, xPilot, or MSFS."
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,4,0,0" />
                  </StackPanel>
                  <Border Grid.Column="1"
                          Background="{StaticResource StatusOkSubtleBrush}"
                          CornerRadius="8"
                          Padding="9,4"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top">
                    <TextBlock Text="LOCAL · NO API CREDITS"
                               Style="{StaticResource LabelTextStyle}"
                               Foreground="{StaticResource StatusOkBrush}" />
                  </Border>
                </Grid>

                <CheckBox Content="Enable live traffic awareness"
                          IsChecked="{Binding EnableLiveTraffic}"
                          FontWeight="SemiBold"
                          Margin="0,0,0,6" />
                <TextBlock Text="FSLTL supplies the model and airline; Microsoft Flight Simulator controls the aircraft movement. StormATC reads position, speed, heading, vertical speed, and ground state. It never spawns, steers, or removes traffic."
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap"
                           Margin="24,0,0,12" />

                <Border Background="{StaticResource SurfaceInsetBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10">
                  <StackPanel>
                    <TextBlock Text="DETECTION STATUS" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding TrafficIntegrationStatus}"
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <TextBlock Text="FlyByWire SimBridge is not required for traffic. FSLTL traffic is identified from its SimConnect aircraft model title, including models installed through the FlyByWire Installer."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Background traffic radio"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0" />
                    <TextBlock Text="Optional controller-and-pilot exchanges for aircraft already moving in the simulator."
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,4,0,0" />
                  </StackPanel>
                  <Border Grid.Column="1"
                          Background="{StaticResource StatusWarnSubtleBrush}"
                          CornerRadius="8"
                          Padding="9,4"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top">
                    <TextBlock Text="EXPERIMENTAL · OPT IN"
                               Style="{StaticResource LabelTextStyle}"
                               Foreground="{StaticResource StatusWarnBrush}" />
                  </Border>
                </Grid>

                <CheckBox Content="Generate occasional traffic radio exchanges"
                          IsChecked="{Binding EnableRadioChatter}"
                          IsEnabled="{Binding IsTrafficEnabled}"
                          Margin="0,0,0,8" />
                <CheckBox Content="Use the selected language model for more natural wording"
                          IsChecked="{Binding UseLanguageModelForChatter}"
                          IsEnabled="{Binding IsTrafficChatterEnabled}"
                          Margin="24,0,0,8" />
                <TextBlock Text="Off uses the local deterministic phrase set and consumes no language-model credits. On permits one short, constrained model request per exchange."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="48,-3,0,9"
                           TextWrapping="Wrap" />
                <CheckBox Content="Speak both controller and traffic-pilot lines"
                          IsChecked="{Binding SpeakChatter}"
                          IsEnabled="{Binding IsTrafficChatterEnabled}"
                          Margin="24,0,0,8" />
                <TextBlock Text="Speaking uses the configured text-to-speech service twice per exchange. Text-only exchanges remain visible without TTS."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="48,-3,0,0"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Usage and online-network safeguards"
                           Style="{StaticResource SectionHeaderStyle}" />
                <CheckBox Content="Pause generated chatter while vPilot, xPilot, swift, or PilotEdge is running"
                          IsChecked="{Binding PauseChatterWhenOnlineAtcClientDetected}"
                          Margin="0,0,0,12" />
                <TextBlock Text="This avoids fake background calls competing with real online controllers and pilots."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="24,-8,0,14" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="MAXIMUM EXCHANGES PER HOUR"
                               Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding MaximumTrafficExchangesPerHour,
                                              StringFormat={}{0} exchanges / hour}"
                               FontFamily="{StaticResource ValueFontFamily}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0" />
                  </StackPanel>
                  <Slider Grid.Column="1"
                          Minimum="1"
                          Maximum="30"
                          TickFrequency="1"
                          IsSnapToTickEnabled="True"
                          Value="{Binding MaximumTrafficExchangesPerHour}"
                          IsEnabled="{Binding IsTrafficChatterEnabled}"
                          VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="This is a hard runtime ceiling. With speech enabled, each exchange can make two TTS requests; with AI wording enabled, it can make one model request."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ==================== Voice and PTT ==================== -->
      <TabItem Header="Voice &amp; PTT"
               Style="{StaticResource SettingsTabItemStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,18">
          <StackPanel MaxWidth="1040" HorizontalAlignment="Left">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Speech engines"
                           Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock Text="Deepgram runs in the cloud and needs a key. Whisper (recognition) and Piper (controller voice) run on this computer: no account, no network. Download them once with the buttons below, then fill in the paths. Save, then test."
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />
                <WrapPanel Margin="0,0,0,14">
                  <Button Content="Download guide"
                          Command="{Binding OpenDownloadPageCommand}"
                          CommandParameter="https://github.com/feanor91/StormATC/blob/main/docs/third-party-downloads.md"
                          Style="{StaticResource PrimaryButtonStyle}"
                          Margin="0,0,8,0" />
                  <Button Content="Get Whisper"
                          Command="{Binding OpenDownloadPageCommand}"
                          CommandParameter="https://github.com/ggml-org/whisper.cpp/releases"
                          Margin="0,0,8,0" />
                  <Button Content="Get Whisper models"
                          Command="{Binding OpenDownloadPageCommand}"
                          CommandParameter="https://huggingface.co/ggerganov/whisper.cpp/tree/main"
                          Margin="0,0,8,0" />
                  <Button Content="Get Piper"
                          Command="{Binding OpenDownloadPageCommand}"
                          CommandParameter="https://github.com/rhasspy/piper/releases/tag/2023.11.14-2"
                          Margin="0,0,8,0" />
                  <Button Content="Get Piper voices"
                          Command="{Binding OpenDownloadPageCommand}"
                          CommandParameter="https://huggingface.co/rhasspy/piper-voices/tree/main" />
                </WrapPanel>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="1*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock Text="SPEECH TO TEXT" Style="{StaticResource LabelTextStyle}" />
                    <ComboBox ItemsSource="{Binding RecognitionEngines}"
                              SelectedItem="{Binding SpeechToTextProvider}"
                              Width="180"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,12" />

                    <TextBlock Text="WHISPER-CLI.EXE PATH" Style="{StaticResource LabelTextStyle}" />
                    <TextBox Text="{Binding WhisperExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12" />

                    <TextBlock Text="WHISPER MODEL (.BIN, MULTILINGUAL)" Style="{StaticResource LabelTextStyle}" />
                    <TextBox Text="{Binding WhisperModelPath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12" />
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <TextBlock Text="CONTROLLER VOICE" Style="{StaticResource LabelTextStyle}" />
                    <ComboBox ItemsSource="{Binding VoiceEngines}"
                              SelectedItem="{Binding TextToSpeechProvider}"
                              Width="180"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,12" />

                    <TextBlock Text="PIPER.EXE PATH" Style="{StaticResource LabelTextStyle}" />
                    <TextBox Text="{Binding PiperExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12" />

                    <TextBlock Text="PIPER FRENCH VOICE (.ONNX)" Style="{StaticResource LabelTextStyle}" />
                    <TextBox Text="{Binding PiperFrenchVoicePath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12" />

                    <TextBlock Text="PIPER ENGLISH VOICE (.ONNX)" Style="{StaticResource LabelTextStyle}" />
                    <TextBox Text="{Binding PiperEnglishVoicePath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12" />

                    <TextBlock Text="EXTRA PIPER VOICES FOLDER" Style="{StaticResource LabelTextStyle}" />
                    <TextBox Text="{Binding PiperVoicesFolder, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,6" />
                    <TextBlock Text="Voices named fr_* or en_* in this folder join the cast. Each controller gets its own voice and speaking rate."
                               Style="{StaticResource SecondaryTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <CheckBox Content="Give each controller a different voice"
                              IsChecked="{Binding VaryControllerVoices}"
                              Margin="0,0,0,12" />
                  </StackPanel>
                </Grid>

                <WrapPanel>
                  <Button Content="Save settings"
                          Command="{Binding SaveSettingsCommand}"
                          Style="{StaticResource PrimaryButtonStyle}"
                          Margin="0,0,8,0" />
                  <Button Content="Test speech engines"
                          Command="{Binding TestLocalVoiceCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding LocalVoiceTestResult}"
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Visibility="{Binding LocalVoiceTestResult,
                                                Converter={StaticResource StringToVisibility}}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Voice recognition trainer"
                           Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock Text="Record a few phrases in your normal accent. StormATC stores only recognition hints and explicit text corrections—not the training audio."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,14" />

                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="1*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                    <TextBlock Text="MICROPHONE" Style="{StaticResource LabelTextStyle}" />
                    <ComboBox ItemsSource="{Binding InputDevices}"
                              SelectedItem="{Binding SelectedInputDevice}"
                              ToolTip="{Binding SelectedInputDevice}"
                              ToolTipService.ShowDuration="60000"
                              MaxDropDownHeight="360" />
                  </StackPanel>

                  <StackPanel Grid.Row="2">
                    <TextBlock Text="RECOGNITION LANGUAGE"
                               Style="{StaticResource LabelTextStyle}" />
                    <ComboBox ItemsSource="{Binding SpeechRecognitionLanguages}"
                              SelectedItem="{Binding SpeechRecognitionLanguage}"
                              Width="180"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,12" />

                    <TextBlock Text="EXPECTED PHRASE" Style="{StaticResource LabelTextStyle}" />
                    <ComboBox ItemsSource="{Binding TrainingPhrases}"
                              Text="{Binding TrainingExpectedPhrase,
                                             UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              Margin="0,0,0,10" />

                    <Button Content="Record 6-second sample"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding RecordVoiceTrainingCommand}"
                            HorizontalAlignment="Left" />
                  </StackPanel>

                  <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="HEARD BY DEEPGRAM"
                               Style="{StaticResource LabelTextStyle}" />
                    <TextBox Text="{Binding TrainingTranscript,
                                           UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="42"
                             Margin="0,0,0,10" />
                    <WrapPanel>
                      <Button Content="Save correction"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Command="{Binding SaveTrainingCorrectionCommand}"
                              Margin="0,0,8,0" />
                      <Button Content="Clear trained phrases"
                              Command="{Binding ClearVoiceTrainingCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding TrainingCorrectionCount,
                                             StringFormat=Saved corrections: {0}}"
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,10,0,0" />

                    <Border Background="{StaticResource SurfaceInsetBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding TrainingStatus,
                                                 Converter={StaticResource StringToVisibility}}">
                      <TextBlock Text="{Binding TrainingStatus}"
                                 Style="{StaticResource SecondaryTextStyle}" />
                    </Border>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Push-to-talk controls"
                           Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock Text="The configured keyboard key now works everywhere in StormATC. You can also bind any button from a USB joystick, yoke, gamepad or HOTAS."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,14" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel>
                    <TextBlock Text="KEYBOARD KEY" Style="{StaticResource LabelTextStyle}" />
                    <TextBox Text="{Binding PushToTalkKey, UpdateSourceTrigger=PropertyChanged}"
                             Width="180"
                             HorizontalAlignment="Left" />
                    <TextBlock Text="Examples: Space, LeftCtrl, F12"
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,7,0,0" />
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <TextBlock Text="JOYSTICK / HOTAS" Style="{StaticResource LabelTextStyle}" />
                    <ComboBox ItemsSource="{Binding JoystickDevices}"
                              SelectedItem="{Binding SelectedJoystick}"
                              DisplayMemberPath="DisplayName"
                              MinWidth="380"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,10" />
                    <WrapPanel Margin="0,0,0,10">
                      <Button Content="Refresh controllers"
                              Command="{Binding RefreshJoysticksCommand}"
                              Margin="0,0,8,0" />
                      <Button Content="Bind next button"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Command="{Binding BindJoystickButtonCommand}"
                              Margin="0,0,8,0" />
                      <Button Content="Clear binding"
                              Command="{Binding ClearJoystickBindingCommand}" />
                    </WrapPanel>
                    <CheckBox Content="Enable joystick push-to-talk"
                              IsChecked="{Binding JoystickPushToTalkEnabled}"
                              Margin="0,0,0,10" />
                    <Border Background="{StaticResource SurfaceInsetBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                      <TextBlock Text="{Binding JoystickBindingStatus}"
                                 Style="{StaticResource SecondaryTextStyle}" />
                    </Border>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ==================== ATC behaviour ==================== -->
      <TabItem Header="ATC behaviour"
               Style="{StaticResource SettingsTabItemStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,18">
          <StackPanel MaxWidth="1040" HorizontalAlignment="Left">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Languages" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock Text="INTERFACE" Style="{StaticResource LabelTextStyle}" />
                <ComboBox ItemsSource="{Binding InterfaceLanguages}"
                          SelectedItem="{Binding InterfaceLanguage}"
                          Width="240"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,6" />
                <TextBlock Text="Menus, labels and messages. Takes effect at the next start."
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap"
                           MaxWidth="760"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,14" />
                <TextBlock Text="RADIO" Style="{StaticResource LabelTextStyle}" />
                <ComboBox ItemsSource="{Binding AtcLanguages}"
                          SelectedItem="{Binding AtcLanguage}"
                          Width="240"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,6" />
                <TextBlock Text="Controllers, the ATIS and speech recognition use this language. French follows the DSNA phraseology (« roulez point d'attente piste 27 », « transpondeur trente-deux cinquante-quatre »). Clearances and readback checks are decided by the same engine in both languages. Applies to the running session when saved."
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap"
                           MaxWidth="760"
                           HorizontalAlignment="Left" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Realism profile" Style="{StaticResource SectionHeaderStyle}" />
                <ComboBox ItemsSource="{Binding RealismProfiles}"
                          SelectedItem="{Binding RealismProfile}"
                          Width="240"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,6" />
                <TextBlock Text="{Binding RealismProfileDescription}"
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap"
                           MaxWidth="760"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,10" />
                <Border Background="{StaticResource AccentSubtleBrush}"
                        BorderBrush="{StaticResource AccentDimBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="TRANSCRIPT INTERPRETATION"
                               Style="{StaticResource LabelTextStyle}"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding TranscriptToleranceNotice}"
                               Style="{StaticResource SecondaryTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                  </StackPanel>
                </Border>

                <TextBlock Text="Default GSX pushback direction"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <ComboBox ItemsSource="{Binding PushbackDirectionChoices}"
                          SelectedItem="{Binding DefaultPushbackDirection}"
                          Width="240"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,4" />
                <TextBlock Text="Used when the pilot requests pushback without saying tail left or tail right."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,14" />

                <CheckBox Content="Hold further clearances until an outstanding readback is correct"
                          IsChecked="{Binding RequireReadbackBeforeProgressing}"
                          Margin="0,0,0,8" />
                <CheckBox Content="Refuse transmissions that use the wrong callsign"
                          IsChecked="{Binding RequireCorrectCallsign}"
                          Margin="0,0,0,8" />
                <CheckBox Content="Warn when a hold-short line is crossed without clearance"
                          IsChecked="{Binding EnforceHoldShort}"
                          Margin="0,0,0,8" />
                <CheckBox Content="Require a check-in after every frequency change"
                          IsChecked="{Binding RequireCheckInOnFrequencyChange}"
                          Margin="0,0,0,8" />
                <CheckBox Content="Let the language model phrase approved responses"
                          IsChecked="{Binding UseLanguageModelPhraseology}"
                          Margin="0,0,0,4" />
                <TextBlock Text="The deterministic engine decides the clearance. Model wording is accepted only after every operational fact and number is validated."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="24,0,0,0" />
              </StackPanel>
            </Border>

            <Border Background="{StaticResource AccentSubtleBrush}"
                    BorderBrush="{StaticResource AccentDimBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE946;"
                           FontFamily="{StaticResource IconFontFamily}"
                           FontSize="22"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                  <TextBlock Text="Production-safe model boundary"
                             FontSize="15"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Language-model output cannot move the aircraft, change simulator controls, or bypass the ATC state engine. Invalid output falls back to deterministic phraseology."
                             Style="{StaticResource SecondaryTextStyle}"
                             Margin="0,5,0,0" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ==================== Privacy ==================== -->
      <TabItem Header="Privacy"
               Style="{StaticResource SettingsTabItemStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,18">
          <StackPanel MaxWidth="1040" HorizontalAlignment="Left">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Privacy and local data"
                           Style="{StaticResource SectionHeaderStyle}" />

                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                  </Grid.ColumnDefinitions>

                  <Border Background="{StaticResource StatusOkSubtleBrush}"
                          CornerRadius="9"
                          Padding="12">
                    <StackPanel>
                      <TextBlock Text="API KEYS" Style="{StaticResource LabelTextStyle}" />
                      <TextBlock Text="Windows DPAPI"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource StatusOkBrush}"
                                 Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2"
                          Background="{StaticResource StatusOkSubtleBrush}"
                          CornerRadius="9"
                          Padding="12">
                    <StackPanel>
                      <TextBlock Text="TELEMETRY" Style="{StaticResource LabelTextStyle}" />
                      <TextBlock Text="None"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource StatusOkBrush}"
                                 Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="4"
                          Background="{StaticResource StatusOkSubtleBrush}"
                          CornerRadius="9"
                          Padding="12">
                    <StackPanel>
                      <TextBlock Text="MICROPHONE" Style="{StaticResource LabelTextStyle}" />
                      <TextBlock Text="Push-to-talk only"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource StatusOkBrush}"
                                 Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>
                </Grid>

                <CheckBox Content="Store transcripts in the local database"
                          IsChecked="{Binding StoreTranscripts}"
                          Margin="0,0,0,10" />
                <TextBlock Text="Raw microphone audio is never written to disk. Voice training stores only the expected text and explicit corrections."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,16" />

                <Button Content="Clear all local history"
                        Command="{Binding ClearLocalHistoryCommand}"
                        HorizontalAlignment="Left" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Where settings are stored"
                           Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock Text="{Binding SettingsFilePath}"
                           FontFamily="{StaticResource ValueFontFamily}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="This JSON file contains non-secret preferences only. API keys are stored separately as encrypted ciphertext."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Persistent save bar: users no longer have to scroll to the bottom of a giant page. -->
    <Border Grid.Row="2"
            Background="{StaticResource SurfaceElevatedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="26,12">
      <Grid MaxWidth="1040" HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Content="Save all changes"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding SaveSettingsCommand}" />
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusMessage}"
                     Style="{StaticResource SecondaryTextStyle}"
                     TextWrapping="Wrap"
                     MaxWidth="720" />
          <TextBlock Text="  •  Ctrl+5 opens Settings"
                     Style="{StaticResource SecondaryTextStyle}"
                     Foreground="{StaticResource TextTertiaryBrush}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>

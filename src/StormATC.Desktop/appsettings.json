{
  "$comment": [
    "StormATC default configuration.",
    "",
    "API KEYS ARE NOT STORED HERE and must never be added to this file. They live in the",
    "OS secret store (DPAPI on Windows) and are entered through Settings. See",
    "docs/privacy-and-api-keys.md.",
    "",
    "Precedence, lowest to highest:",
    "  appsettings.json -> appsettings.{Environment}.json -> environment variables",
    "  prefixed STORMATC_ -> command-line arguments."
  ],

  "Application": {
    "OfflineMode": false,
    "DeveloperMode": false,
    "CloudServicesConsentGiven": false,
    "FirstRunCompleted": false,
    "RealismProfile": "Standard"
  },

  "OpenRouter": {
    "BaseUrl": "https://openrouter.ai/api/v1",
    "Model": "",
    "Timeout": "00:00:20",
    "MaximumRetries": 2,
    "IntentParserTemperature": 0.0,
    "PhraseologyTemperature": 0.2,
    "MaximumResponseBytes": 262144,
    "RefererUrl": "https://github.com/stormatc/stormatc",
    "ApplicationTitle": "StormATC"
  },

  "Deepgram": {
    "BaseUrl": "https://api.deepgram.com",
    "StreamingUrl": "wss://api.deepgram.com/v1/listen",
    "SpeechToTextModel": "nova-3",
    "Voice": "aura-2-thalia-en",
    "Language": "en",
    "SampleRate": 16000,
    "MaximumTransmissionDuration": "00:00:30",
    "ConnectionTimeout": "00:00:08",
    "InputDeviceName": "",
    "RecognitionKeyterms": [],
    "TranscriptCorrections": {}
  },

  "SimBrief": {
    "BaseUrl": "https://www.simbrief.com/api/xml.fetcher.php",
    "UserId": "",
    "Timeout": "00:00:15",
    "StaleThreshold": "12:00:00",
    "CacheRawResponses": false
  },

  "Simulator": {
    "PreferredConnector": "MSFS",
    "UpdatesPerSecond": 5,
    "ReconnectInterval": "00:00:05",
    "AutoReconnect": true
  },

  "Audio": {
    "ControllerVolume": 0.85,
    "RadioEffectEnabled": true,
    "RadioEffectStrength": 0.5,
    "StaticLevel": 0.08,
    "TransmissionClicksEnabled": true,
    "Muted": false,
    "CleanAudioMode": false,
    "PushToTalkKey": "Space",
    "JoystickPushToTalkEnabled": false,
    "JoystickDeviceId": null,
    "JoystickDeviceName": null,
    "JoystickButtonIndex": null
  },

  "Persistence": {
    "StoreTranscripts": true,
    "RetentionPeriod": "30.00:00:00",
    "AutomaticRetentionSweep": true
  },

  "AtcRealism": {
    "RequireReadbackBeforeProgressing": true,
    "RequireCorrectCallsign": true,
    "EnforceHoldShort": true,
    "RequireCheckInOnFrequencyChange": false,
    "MinimumIntentConfidence": 0.6,
    "LanguageModelEscalationThreshold": 0.7,
    "UseLanguageModelPhraseology": true
  },

  "Diagnostics": {
    "RecordLatencyMetrics": true,
    "LatencySampleCount": 100,
    "LogRetentionDays": 7,
    "ShowPromptHashes": true
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}

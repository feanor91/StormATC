<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>StormATC.Application</RootNamespace>
    <Description>
      Application layer for StormATC: use cases, provider abstractions, the pilot transmission
      pipeline, and strongly typed options. Depends on the domain and on abstractions only —
      never on a concrete provider implementation.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StormATC.Domain\StormATC.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Interface translations, keyed by the English text. See Localization/UiText.cs. -->
    <EmbeddedResource Include="Localization\fr.json"
                      LogicalName="StormATC.Application.Localization.fr.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

</Project>

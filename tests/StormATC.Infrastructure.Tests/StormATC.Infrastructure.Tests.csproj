<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches the Infrastructure target: DPAPI and NAudio are Windows-only. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>StormATC.Infrastructure.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup Condition="'$(MsfsSimConnectPath)' != '' AND Exists('$(MsfsSimConnectPath)')">
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>$(MsfsSimConnectPath)</HintPath>
      <Private>true</Private>
      <IncludeRuntimeDependency>true</IncludeRuntimeDependency>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(MsfsSimConnectNativePath)' != '' AND Exists('$(MsfsSimConnectNativePath)')">
    <Content Include="$(MsfsSimConnectNativePath)" Link="SimConnect.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StormATC.Infrastructure\StormATC.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\data\**\*.json" LinkBase="data">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- The prompt catalog reads these from disk at runtime, so the tests need them too. -->
    <Content Include="..\..\prompts\**\*.md" LinkBase="prompts">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
